    "empty-state",
    "validation-errors",
    "custom-headers"
  ],
  "complexity": "advanced",
  "featured": true,
  "limitations": [
    "Query parameters describe the intended API contract but do not dynamically filter, sort, or paginate responses yet.",
    "Path parameters do not select seed records automatically; choose the required response scenario manually.",
    "Creating a redemption returns a configured response but does not change member balances or persist a redemption."
